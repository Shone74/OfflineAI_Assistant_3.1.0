# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Installer build output (compiled .exe artifacts — PHASE 6)
installer_output/

# Virtual environments
.venv/
venv/
env/

# Test caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# AI models (large binaries — see docs/models_report.md)
models/llm/*.gguf
models/voice/**/*.bin
models/voice/**/*.pt
*.gguf

# Runtime data (app uses %LOCALAPPDATA%\OfflineAI at runtime)
logs/
data/*.db
data/*.db-journal
config/*.local.json

# Runtime data — project-local database folder (never track live DBs/audit logs)
database/*.db
database/*.sqlite
database/*.sqlite3
database/*.log

# Root clutter — screenshots and generated PDF manuals (kept on disk only)
Pictures/
*.pdf

# OS
Thumbs.db
desktop.ini
.DS_Store

# IDE
.vscode/
.idea/
*.swp

# Design preview outputs (generated HTML)
design_previews/*.html
